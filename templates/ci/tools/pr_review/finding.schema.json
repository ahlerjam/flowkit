{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahlerjam/flowkit/templates/ci/tools/pr_review/finding.schema.json",
  "title": "flowkit PR-Review Finding Set",
  "type": "object",
  "required": ["findings", "reviewer", "confidence_filter"],
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "confidence_filter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "title", "evidence"],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "title": { "type": "string", "maxLength": 200 },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "evidence": { "type": "string", "maxLength": 2000 },
          "recommendation": { "type": ["string", "null"] },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
          "source_reviewer": { "type": "string" }
        }
      }
    }
  }
}
