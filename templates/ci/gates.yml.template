name: flowkit-gates
on:
  pull_request:
  push:
    branches: ["{{DEFAULT_BRANCH}}"]
jobs:
  gates:
    runs-on: {{RUNNER_LABELS}}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v6
      - name: Setup
        run: {{SETUP_CMD}}
      - name: Lint (blocking)
        run: {{LINT_CMD}}
      - name: Typecheck (blocking)
        run: {{TYPECHECK_CMD}}
      - name: Tests (blocking)
        run: {{TEST_CMD}}
