{
  "repoSlug": "OWNER/REPO",
  "defaultBranch": "main",
  "pushCommand": "git push",
  "commands": {
    "setup": "{{SETUP_CMD_OR_EMPTY}}",
    "test": "{{TEST_CMD}}",
    "lint": "{{LINT_CMD}}",
    "typecheck": "{{TYPECHECK_CMD_OR_EMPTY}}",
    "smoke": "{{SMOKE_CMD_OR_EMPTY}}"
  },
  "extraGates": [],
  "protectedAreas": [
    "security",
    "auth",
    "billing",
    "migrations",
    "scaling"
  ],
  "areas": [
    "frontend",
    "backend",
    "infra",
    "security",
    "auth",
    "billing",
    "migrations",
    "scaling",
    "docs"
  ],
  "parallelism": 3,
  "caps": {
    "maxParallel": 4,
    "issuesPerRun": 10,
    "groomingIssuesPerWeek": 15
  },
  "budgets": {
    "S": {
      "turns": 20,
      "tokens": 200000
    },
    "M": {
      "turns": 60,
      "tokens": 500000
    },
    "L": {
      "turns": 120,
      "tokens": 1100000
    }
  },
  "opusTurnWeight": 3,
  "runBudgetFactor": 1.2,
  "models": {
    "grooming": "haiku",
    "planner": {
      "SM": "sonnet",
      "L": "opus"
    },
    "builder": {
      "SM": "sonnet",
      "L": "opus"
    },
    "verifier": "sonnet",
    "escalation": "opus"
  },
  "autoReady": {
    "impulse": "P2",
    "gapScan": "off"
  },
  "maxFixRounds": 3,
  "progressStopAfter": 3,
  "mergeCheck": "coordinator",
  "ciInfraSignatures": [],
  "overrideLabel": "override-claude-review",
  "markers": {
    "plan": "<!-- plan:v1 -->",
    "acVerify": "<!-- ac-verify:v2 -->"
  },
  "milestoneExcludeRegex": "",
  "excludeLabels": [
    "type/operator",
    "type/epic"
  ],
  "respectDependencies": true,
  "learnings": true,
  "issueLimit": 300,
  "browserProof": false,
  "notify": false,
  "onSmokeFailure": "revert"
}
