{
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git log*)", "Bash(git diff)", "Bash(git diff *)", "Bash(git branch*)",
      "Bash(git fetch*)", "Bash(git worktree*)", "Bash(git add*)", "Bash(git commit*)",
      "Bash(gh issue view*)", "Bash(gh issue list*)", "Bash(gh issue comment*)",
      "Bash(gh issue edit*)", "Bash(gh issue create*)", "Bash(gh issue close*)",
      "Bash(gh pr view*)", "Bash(gh pr list*)", "Bash(gh pr diff*)", "Bash(gh pr checks*)",
      "Bash(gh pr comment*)", "Bash(gh pr create*)", "Bash(gh pr merge*)", "Bash(gh pr ready*)",
      "Bash(gh milestone list*)", "Bash(gh sub-issue*)", "Bash(gh run list*)", "Bash(gh run view*)",
      "Bash(gh label list*)", "Bash(gh api repos/*/branches/*/protection)",
      "Bash(git push*)", "Bash(git switch*)",
      "Bash(git merge origin/*)", "Bash(git merge --abort)", "Bash(git merge --continue)",
      "Bash(jq *)", "Bash(mktemp *)",
      "Bash(bash {{PLUGIN_ROOT}}/scripts/*)", "Bash(python3 {{PLUGIN_ROOT}}/scripts/*)",
      "Bash(bash {{PLUGIN_ROOT}}/templates/hooks/*)",
      "Bash(gh pr edit*)", "Bash(gh run rerun*)",
      "Bash(git check-ignore*)", "Bash(git merge-base*)", "Bash(git revert*)",
      "Bash(tail *)", "Bash(head *)", "Bash(sort *)", "Bash(uniq *)",
      "Bash(awk '{print $4}')", "Bash(awk {print $4})",
      {{STACK_ALLOW}}
    ],
    "deny": [
      "Bash(rm -rf /*)", "Bash(sudo *)", "Bash(chmod 777 *)",
      "Read(/.env)", "Read(/.env.*)", "Read(/**/.env)", "Read(/**/.env.*)",
      "Read(/**/secrets*)", "Read(/**/*credentials*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-context.sh\" ] && \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-context.sh\" || exit 0" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-blocker.sh\"; if [ -x \"$f\" ]; then \"$f\"; else echo '[flowkit-hook] pretooluse-blocker.sh missing or not executable - blocking as precaution' >&2; exit 2; fi" },
        { "type": "command", "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/pushci-guard.sh\" ] && \"$CLAUDE_PROJECT_DIR/.claude/hooks/pushci-guard.sh\" || exit 0" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [
        { "type": "command", "command": "jq -r '.tool_input.file_path // .tool_response.filePath // \"\"' | { read -r f; case \"$f\" in *.py) (cd \"$CLAUDE_PROJECT_DIR\" && {{FORMAT_CMD_PY}} \"$f\") 2>&1 || true ;; esac; }" }
      ] }
    ]
  }
}
