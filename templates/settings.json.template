{
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git log*)", "Bash(git diff*)", "Bash(git branch*)",
      "Bash(git fetch*)", "Bash(git worktree*)", "Bash(git add*)", "Bash(git commit*)",
      "Bash(gh issue view*)", "Bash(gh issue list*)", "Bash(gh issue comment*)",
      "Bash(gh issue edit*)", "Bash(gh issue create*)", "Bash(gh issue close*)",
      "Bash(gh pr view*)", "Bash(gh pr list*)", "Bash(gh pr diff*)", "Bash(gh pr checks*)",
      "Bash(gh pr comment*)", "Bash(gh pr create*)", "Bash(gh milestone list*)",
      "Bash(gh sub-issue*)", "Bash(gh run list*)", "Bash(gh label list*)",
      "Bash(jq *)", "Bash(mktemp*)", "Bash(codex exec*)",
      {{STACK_ALLOW}}
    ],
    "deny": [
      "Bash(rm -rf /*)", "Bash(sudo *)", "Bash(chmod 777 *)",
      "Read(/.env)", "Read(/.env.*)", "Read(/**/.env)", "Read(/**/.env.*)",
      "Read(/**/secrets*)", "Read(/**/*credentials*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-context.sh\" ] && \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-context.sh\" || exit 0" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-blocker.sh\" ] && \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-blocker.sh\" || exit 0" },
        { "type": "command", "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/pushci-guard.sh\" ] && \"$CLAUDE_PROJECT_DIR/.claude/hooks/pushci-guard.sh\" || exit 0" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [
        { "type": "command", "command": "jq -r '.tool_input.file_path // .tool_response.filePath // \"\"' | { read -r f; case \"$f\" in *.py) (cd \"$CLAUDE_PROJECT_DIR\" && {{FORMAT_CMD_PY}} \"$f\") 2>&1 || true ;; esac; }" }
      ] }
    ]
  }
}
